#!/usr/bin/env bash
#
# Refuse the commit if the Jekyll site does not build.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
#
# Note: this builds the working tree, not the staged snapshot. A commit of a
# partial staging area can still break the build; the hook catches the common
# case, not every case. Bypass with `git commit --no-verify`.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if ! command -v bundle >/dev/null 2>&1; then
  echo "pre-commit: bundler not found, skipping build check" >&2
  exit 0
fi

if [ ! -d vendor/bundle ] && ! bundle check >/dev/null 2>&1; then
  echo "pre-commit: gems not installed, skipping build check" >&2
  echo "pre-commit: run 'bundle config set --local path vendor/bundle && bundle install'" >&2
  exit 0
fi

echo "pre-commit: bundle exec jekyll build --strict_front_matter"

if ! output=$(bundle exec jekyll build --strict_front_matter 2>&1); then
  echo "$output" >&2
  echo >&2
  echo "pre-commit: BUILD FAILED -- commit aborted." >&2
  echo "pre-commit: fix the error above, or bypass with 'git commit --no-verify'." >&2
  exit 1
fi

# The sitemap silently disappearing is exactly the failure this repo has
# already chased once (task #4, phase 1.1), so assert it explicitly.
if [ ! -s _site/sitemap.xml ]; then
  echo "pre-commit: _site/sitemap.xml is missing or empty -- commit aborted." >&2
  echo "pre-commit: check that jekyll-sitemap is in plugins and not excluded." >&2
  exit 1
fi

locs=$(grep -c "<loc>" _site/sitemap.xml || true)
if [ "${locs:-0}" -lt 5 ]; then
  echo "pre-commit: sitemap has only ${locs} URLs, expected more -- commit aborted." >&2
  exit 1
fi

echo "pre-commit: build ok, sitemap has ${locs} URLs"
