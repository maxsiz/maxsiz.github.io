source 'https://rubygems.org'

# Pinned to the version GitHub Pages actually builds with, so local builds
# match production. Check https://pages.github.com/versions/ before bumping.
gem "github-pages", '232', group: :jekyll_plugins

# enable tzinfo-data for local build
# gem 'tzinfo-data', platforms: [:mingw, :mswin, :x64_mingw]
gem 'jekyll-paginate'

# webrick left stdlib in Ruby 3.0; Jekyll 3.x needs it for `jekyll serve`
gem 'webrick'
